{"version":3,"kind":"Notebook","sha256":"be425db1fc4191a44176b0573faa7ebd0095df0683bef786eb5ac4af2894a066","slug":"laboratory-task-2","location":"/Laboratory Task 2.ipynb","dependencies":[],"frontmatter":{"kernelspec":{"name":"conda-base-py","display_name":"Python [conda env:base] *","language":"python"},"authors":[{"nameParsed":{"literal":"Kayla Nicole Jade T. Abris","given":"Kayla Nicole Jade T.","family":"Abris"},"name":"Kayla Nicole Jade T. Abris","id":"contributors-ds-portfolio\\myst-generated-uid-0"}],"keywords":["Data Science","Time Series Analysis","Social Science","Fertility","Philippines"],"numbering":{"title":{"offset":1}},"exports":[{"format":"ipynb","filename":"Laboratory Task 2.ipynb","url":"/Laboratory Task 2-4819124a451bb1e94953c5443e8b58e0.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"div","class":"alert alert-block alert-success","style":{"fontFamily":"Times New Roman"},"children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"Laboratory Task 2","key":"nKzpHOaR5n"}],"key":"bJmxJgz7Dw"}],"identifier":"laboratory-task-2","label":"Laboratory Task 2","html_id":"laboratory-task-2","implicit":true,"key":"z0xI9FwPbD"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Instruction:","key":"Yc33WZiHMM"}],"key":"pNFwjuXxAi"},{"type":"text","value":" Perform a single forward pass and compute for the error.","key":"IpaliYY2ps"}],"key":"enyHO0S0V9"},{"type":"div","class":"math-display","children":[{"type":"text","value":"x = \\begin{bmatrix} 1 \\\\ 0 \\\\ 1 \\end{bmatrix}","key":"uI28t4wSKt"}],"key":"u228zsJSAF"},{"type":"div","class":"math-display","children":[{"type":"text","value":"y = \\begin{bmatrix} 1 \\end{bmatrix}","key":"cAQFjuA7kK"}],"key":"jyHqnqFNLY"},{"type":"div","class":"math-display","children":[{"type":"text","value":"f=max(0, Z_n)","key":"nLHWZlHEk8"}],"key":"y8rKdWfzGF"},{"type":"code","lang":"python","meta":null,"value":"\\text{hidden unit weights} = \n\\begin{bmatrix}\nw_{11} = 0.2 && w_{12} = -0.3 \\\\\nw_{13} = 0.4 && w_{14} = 0.1 \\\\\nw_{15} = -0.5 && w_{16} = 0.2\n\\end{bmatrix}","key":"bNYiY7Me9O"},{"type":"code","lang":"python","meta":null,"value":"\\text{output unit weights} = \n\\begin{bmatrix}\nw_{21} = -0.3 \\\\\nw_{22} = -0.2\n\\end{bmatrix}","key":"z1w62uHfLv"},{"type":"code","lang":"python","meta":null,"value":"\\theta = \n\\begin{bmatrix}\n\\theta_{1} = -0.4 \\\\\n\\theta_{2} = 0.2 \\\\\n\\theta_{3} = 0.1\n\\end{bmatrix}","key":"s33NcaZKJm"}],"key":"NUY2x3E854"}],"key":"Jeoe2gP1pz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# input\nx = np.array([1, 0, 1])\ny = 1\n\n# hidden weights\nw11 = 0.2\nw12 = -0.3\nw13 = 0.4\nw14 = 0.1\nw15 = -0.5\nw16 = 0.2\n\n# output weights\nw21 = -0.3\nw22 = -0.2\n\n# biases\ntheta1 = -0.4\ntheta2 = 0.2\ntheta3 = 0.1\n\n# ReLU function\ndef relu(z):\n    return max(0, z)\n\n# forward pass\nz1 = w11*x[0] + w13*x[1] + w15*x[2] + theta1\nh1 = relu(z1)\n\nz2 = w12*x[0] + w14*x[1] + w16*x[2] + theta2\nh2 = relu(z2)\n\nz3 = w21*h1 + w22*h2 + theta3\nyhat = relu(z3)\n\n# error\nerror = yhat - y\n\nprint(\"Z1 =\", z1)\nprint(\"H1 =\", h1)\nprint(\"Z2 =\", z2)\nprint(\"H2 =\", h2)\nprint(\"Z3 =\", z3)\nprint(\"Prediction =\", yhat)\nprint(\"Error =\", error)","key":"G8HC6mnB6b"},{"type":"outputs","id":"HPaGV69k9IvG9-OKDMvnB","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Z1 = -0.7\nH1 = 0\nZ2 = 0.10000000000000003\nH2 = 0.10000000000000003\nZ3 = 0.08\nPrediction = 0.08\nError = -0.92\n"},"children":[],"key":"EW1Jn7HOJG"}],"key":"Ta0eYDIxMA"}],"key":"DLO9yFlC4j"}],"key":"tQraROYIq6"},"references":{"cite":{"order":[],"data":{}}}}
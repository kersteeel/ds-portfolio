ite-packages (from torch) (3.1.6)\nRequirement already satisfied: fsspec>=0.8.5 in d:\\anacondaaa\\lib\\site-packages (from torch) (2025.3.2)\nRequirement already satisfied: numpy in d:\\anacondaaa\\lib\\site-packages (from torchvision) (2.1.3)\nRequirement already satisfied: pillow!=8.3.*,>=5.3.0 in d:\\anacondaaa\\lib\\site-packages (from torchvision) (11.1.0)\nRequirement already satisfied: mpmath<1.4,>=1.1.0 in d:\\anacondaaa\\lib\\site-packages (from sympy>=1.13.3->torch) (1.3.0)\nRequirement already satisfied: MarkupSafe>=2.0 in d:\\anacondaaa\\lib\\site-packages (from jinja2->torch) (3.0.2)\n"},"children":[],"key":"ZZRxpe0843"}],"key":"d3dcRY70pJ"}],"key":"eOsF9rIceB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import torch\nimport torch.nn as nn\nimport numpy as np\n\nfrom torch.utils.data import TensorDataset, DataLoader","key":"lzckdOT7GJ"},{"type":"outputs","id":"ORZGqJzVlKrnRCDsEDIEF","children":[],"key":"ihqPTt33At"}],"key":"catmEVqNxO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Input data\nx_train = np.array([\n    [73, 67, 43],\n    [91, 88, 64],\n    [87, 134, 58],\n    [102, 43, 37],\n    [69, 96, 70],\n    [73, 67, 43],\n    [91, 88, 64],\n    [87, 134, 58],\n    [102, 43, 37],\n    [69, 96, 70],\n    [73, 67, 43],\n    [91, 88, 64],\n    [87, 134, 58],\n    [102, 43, 37],\n    [69, 96, 70]\n], dtype='float32')\n\n# Target data\ny_train = np.array([\n    [56, 70],\n    [81, 101],\n    [119, 133],\n    [22, 37],\n    [103, 119],\n    [56, 70],\n    [81, 101],\n    [119, 133],\n    [22, 37],\n    [103, 119],\n    [56, 70],\n    [81, 101],\n    [119, 133],\n    [22, 37],\n    [103, 119]\n], dtype='float32')","key":"iGP8NyRqMk"},{"type":"outputs","id":"0XIMM4QYCnMyLZj3aZ9e8","children":[],"key":"dQ4InYjwk6"}],"key":"LdLSEZZbhW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"inputs = torch.from_numpy(x_train / 100)\ntargets = torch.from_numpy(y_train / 100)\n\nprint(inputs.shape)\nprint(targets.shape)","key":"UqJYScO31q"},{"type":"outputs","id":"qfXTkLWlSJq8o8_MGRCAx","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"torch.Size([15, 3])\ntorch.Size([15, 2])\n"},"children":[],"key":"vXnVtlFrSy"}],"key":"WIALz0YzEy"}],"key":"Oq3196EpWs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"train_ds = TensorDataset(inputs, targets)\n\nbatch_size = 8\n\ntrain_dl = DataLoader(\n    train_ds,\n    batch_size=batch_size,\n    shuffle=True\n)","key":"PobmJGRIhk"},{"type":"outputs","id":"uyHELTriks1krM7_9tiq-","children":[],"key":"ZwUKp8jIzY"}],"key":"Pd87Depkqu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"model = nn.Sequential(\n    nn.Linear(3, 8),\n    nn.ReLU(),\n    nn.Linear(8, 2)\n)\n\nprint(model)","key":"csVO2unpEn"},{"type":"outputs","id":"w5wypzLsHc9ZFvE8smV92","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Sequential(\n  (0): Linear(in_features=3, out_features=8, bias=True)\n  (1): ReLU()\n  (2): Linear(in_features=8, out_features=2, bias=True)\n)\n"},"children":[],"key":"LJ4LCfKJbL"}],"key":"m2f6y3AJC0"}],"key":"DxqN6RyF4B"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"criterion = nn.MSELoss()\n\noptimizer = torch.optim.SGD(\n    model.parameters(),\n    lr=0.01\n)","key":"NAn6kHqJxs"},{"type":"outputs","id":"7GjGBUZmiEJLX4SOrp-jZ","children":[],"key":"b9DbXqmHHS"}],"key":"st22oXXxKZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"epochs = 1000\n\nfor epoch in range(epochs):\n\n    for xb, yb in train_dl:\n\n        # prediction\n        prediction = model(xb)\n\n        # calculate loss\n        loss = criterion(prediction, yb)\n\n        # remove old gradients\n        optimizer.zero_grad()\n\n        # calculate new gradients\n        loss.backward()\n\n        # update weights\n        optimizer.step()\n\n    if (epoch + 1) % 100 == 0:\n        print(\n            \"Epoch:\", epoch + 1,\n            \"Loss:\", loss.item()\n        )","key":"FYuxSAQBHc"},{"type":"outputs","id":"cAmzmoNrabAg8lI35Vtvy","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Epoch: 100 Loss: 0.06558506190776825\nEpoch: 200 Loss: 0.0666438490152359\nEpoch: 300 Loss: 0.07966522127389908\nEpoch: 400 Loss: 0.024314863607287407\nEpoch: 500 Loss: 0.015436716377735138\nEpoch: 600 Loss: 0.05776287242770195\nEpoch: 700 Loss: 0.036082323640584946\nEpoch: 800 Loss: 0.021301552653312683\nEpoch: 900 Loss: 0.01315303798764944\nEpoch: 1000 Loss: 0.015763556584715843\n"},"children":[],"key":"oupGDqwqNd"}],"key":"ftymTl0yUB"}],"key":"JM8Nh9GFa6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"with torch.no_grad():\n\n    prediction = model(inputs)\n\n    print(\"Predicted values:\")\n    print(prediction * 100)\n\n    print(\"\\nActual values:\")\n    print(targets * 100)","key":"dYOhC96UV3"},{"type":"outputs","id":"BeLRInKmbc_NZ5STI7HlW","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Predicted values:\ntensor([[ 61.5646,  74.4375],\n        [ 77.7665,  93.6293],\n        [122.0564, 141.7716],\n        [ 39.4367,  51.8568],\n        [ 84.7221, 100.0217],\n        [ 61.5646,  74.4375],\n        [ 77.7665,  93.6293],\n        [122.0564, 141.7716],\n        [ 39.4367,  51.8568],\n        [ 84.7221, 100.0217],\n        [ 61.5646,  74.4375],\n        [ 77.7665,  93.6293],\n        [122.0564, 141.7716],\n        [ 39.4367,  51.8568],\n        [ 84.7221, 100.0217]])\n\nActual values:\ntensor([[ 56.0000,  70.0000],\n        [ 81.0000, 101.0000],\n 
ite-packages (from torch) (3.1.6)\nRequirement already satisfied: fsspec>=0.8.5 in d:\\anacondaaa\\lib\\site-packages (from torch) (2025.3.2)\nRequirement already satisfied: numpy in d:\\anacondaaa\\lib\\site-packages (from torchvision) (2.1.3)\nRequirement already satisfied: pillow!=8.3.*,>=5.3.0 in d:\\anacondaaa\\lib\\site-packages (from torchvision) (11.1.0)\nRequirement already satisfied: mpmath<1.4,>=1.1.0 in d:\\anacondaaa\\lib\\site-packages (from sympy>=1.13.3->torch) (1.3.0)\nRequirement already satisfied: MarkupSafe>=2.0 in d:\\anacondaaa\\lib\\site-packages (from jinja2->torch) (3.0.2)\n"},"children":[],"key":"pu47EYGpRN"}],"key":"MP4YHDRJ9u"}],"key":"sYELR8DJnv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import torch\nimport torch.nn as nn\nimport numpy as np\n\nfrom torch.utils.data import TensorDataset, DataLoader","key":"gvL5uPNTkY"},{"type":"outputs","id":"sSK4bky4C-Zx48JMtoHDi","children":[],"key":"MIsDt8jYYk"}],"key":"RNhm0UPyIE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Input data\nx_train = np.array([\n    [73, 67, 43],\n    [91, 88, 64],\n    [87, 134, 58],\n    [102, 43, 37],\n    [69, 96, 70],\n    [73, 67, 43],\n    [91, 88, 64],\n    [87, 134, 58],\n    [102, 43, 37],\n    [69, 96, 70],\n    [73, 67, 43],\n    [91, 88, 64],\n    [87, 134, 58],\n    [102, 43, 37],\n    [69, 96, 70]\n], dtype='float32')\n\n# Target data\ny_train = np.array([\n    [56, 70],\n    [81, 101],\n    [119, 133],\n    [22, 37],\n    [103, 119],\n    [56, 70],\n    [81, 101],\n    [119, 133],\n    [22, 37],\n    [103, 119],\n    [56, 70],\n    [81, 101],\n    [119, 133],\n    [22, 37],\n    [103, 119]\n], dtype='float32')","key":"zytTnAhn5A"},{"type":"outputs","id":"fKhTa7XpUg5zVg0GtQDsT","children":[],"key":"yqjBgGFzdY"}],"key":"zWDOkbNhe8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"inputs = torch.from_numpy(x_train / 100)\ntargets = torch.from_numpy(y_train / 100)\n\nprint(inputs.shape)\nprint(targets.shape)","key":"yaSC4NDJ9h"},{"type":"outputs","id":"cS8mN3REeOxnqN0z8vhtu","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"torch.Size([15, 3])\ntorch.Size([15, 2])\n"},"children":[],"key":"KrYIwp6tTr"}],"key":"rMpoAQt77T"}],"key":"DqmJoVsHen"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"train_ds = TensorDataset(inputs, targets)\n\nbatch_size = 8\n\ntrain_dl = DataLoader(\n    train_ds,\n    batch_size=batch_size,\n    shuffle=True\n)","key":"knI6SwAWkX"},{"type":"outputs","id":"19qLQZFtJFB6RzbBYCuwi","children":[],"key":"zQkJMreejV"}],"key":"fwKVBllvvH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"model = nn.Sequential(\n    nn.Linear(3, 8),\n    nn.ReLU(),\n    nn.Linear(8, 2)\n)\n\nprint(model)","key":"B2ysOLZor4"},{"type":"outputs","id":"Bq4QBqUt8k4LgmiOAd-V1","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Sequential(\n  (0): Linear(in_features=3, out_features=8, bias=True)\n  (1): ReLU()\n  (2): Linear(in_features=8, out_features=2, bias=True)\n)\n"},"children":[],"key":"wejTcPwnP2"}],"key":"QORFMOhvyN"}],"key":"j36cpWCDbM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"criterion = nn.MSELoss()\n\noptimizer = torch.optim.SGD(\n    model.parameters(),\n    lr=0.01\n)","key":"CFl1TrT5Jd"},{"type":"outputs","id":"WlwBqP2TRTsea3hHYRgTH","children":[],"key":"A3P0dQnNRu"}],"key":"YsfTQeiKQU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"epochs = 1000\n\nfor epoch in range(epochs):\n\n    for xb, yb in train_dl:\n\n        # prediction\n        prediction = model(xb)\n\n        # calculate loss\n        loss = criterion(prediction, yb)\n\n        # remove old gradients\n        optimizer.zero_grad()\n\n        # calculate new gradients\n        loss.backward()\n\n        # update weights\n        optimizer.step()\n\n    if (epoch + 1) % 100 == 0:\n        print(\n            \"Epoch:\", epoch + 1,\n            \"Loss:\", loss.item()\n        )","key":"iTRxCACcXS"},{"type":"outputs","id":"RIf1q4SMJTiInuuupOXxH","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Epoch: 100 Loss: 0.06558506190776825\nEpoch: 200 Loss: 0.0666438490152359\nEpoch: 300 Loss: 0.07966522127389908\nEpoch: 400 Loss: 0.024314863607287407\nEpoch: 500 Loss: 0.015436716377735138\nEpoch: 600 Loss: 0.05776287242770195\nEpoch: 700 Loss: 0.036082323640584946\nEpoch: 800 Loss: 0.021301552653312683\nEpoch: 900 Loss: 0.01315303798764944\nEpoch: 1000 Loss: 0.015763556584715843\n"},"children":[],"key":"TvNVKiriFI"}],"key":"BtNgKySLv2"}],"key":"eyJKCNqq1h"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"with torch.no_grad():\n\n    prediction = model(inputs)\n\n    print(\"Predicted values:\")\n    print(prediction * 100)\n\n    print(\"\\nActual values:\")\n    print(targets * 100)","key":"J4favMofYx"},{"type":"outputs","id":"dpWbuLYnZYjRQIL3jqzEg","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Predicted values:\ntensor([[ 61.5646,  74.4375],\n        [ 77.7665,  93.6293],\n        [122.0564, 141.7716],\n        [ 39.4367,  51.8568],\n        [ 84.7221, 100.0217],\n        [ 61.5646,  74.4375],\n        [ 77.7665,  93.6293],\n        [122.0564, 141.7716],\n        [ 39.4367,  51.8568],\n        [ 84.7221, 100.0217],\n        [ 61.5646,  74.4375],\n        [ 77.7665,  93.6293],\n        [122.0564, 141.7716],\n        [ 39.4367,  51.8568],\n        [ 84.7221, 100.0217]])\n\nActual values:\ntensor([[ 56.0000,  70.0000],\n        [ 81.0000, 101.0000],\n        [119.0000, 133.0000],\n        [ 22.0000,  37.0000],\n        [103.0000, 119.0000],\n        [ 56.0000,  70.0000],\n        [ 81.0000, 101.0000],\n        [119.0000, 133.0000],\n        [ 22.0000,  37.0000],\n        [103.0000, 119.0000],\n        [ 56.0000,  70.0000],\n        [ 81.0000, 101.0000],\n        [119.0000, 133.0000],\n        [ 22.0000,  37.0000],\n        [103.0000, 119.0000]])\n"},"children":[],"key":"i8ucYmmSoS"}],"key":"ENPo0yJgcO"}],"key":"yVZAaAI9sP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Conclusion","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PvMKFuSn1l"}],"identifier":"conclusion","label":"Conclusion","html_id":"conclusion","implicit":true,"key":"DZhCgamvrr"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"The model was able to learn from the given data using PyTorch. With two fully connected layers, MSE Loss, SGD optimizer, a batch size of 8, and 1000 epochs, the training process gradually reduced the loss and made the predicted values closer to the actual values. This shows how a simple neural network can be trained to make predictions from a regression dataset.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"CNvLaXFWnv"}],"key":"dJaAIQ4DAl"}],"key":"NyoQm9ZCfA"}],"key":"BDICZhTsuQ"},"references":{"cite":{"order":[],"data":{}}}}